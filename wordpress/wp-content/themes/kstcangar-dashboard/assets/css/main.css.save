/* =============================================
   KST Cangar Dashboard – main.css
   ============================================= */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body.dashboard-page {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: #f3f4f6;
    color: #111827;
}

/* Hide default WordPress theme elements on dashboard */
body.dashboard-page #wpadminbar { position: fixed !important; }
body.dashboard-page header,
body.dashboard-page footer,
body.dashboard-page .site-header,
body.dashboard-page .site-footer,
body.dashboard-page .entry-header,
body.dashboard-page .wp-block-template-part { display: none !important; }

/* ── TOP NAVBAR ─────────────────────────────── */
.top-navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 64px;
    background: #059669;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 28px;
    z-index: 1000;
    box-shadow: 0 2px 16px rgba(0,0,0,.14);
}

body.admin-bar .top-navbar { top: 32px; }

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
    text-decoration: none;
}
body.admin-bar .dashboard-layout{
    padding-top:96px;
}

.brand-logo {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #059669;
    font-size: 16px;
    overflow: hidden;
    flex-shrink: 0;
}

.brand-logo img { width: 100%; height: 100%; object-fit: cover; }
.brand-logo-fallback { display: none; font-weight: 800; color: #059669; }

.brand-title { font-size: 16px; font-weight: 700; line-height: 1.2; }
.brand-sub  { font-size: 11px; opacity: .85; }

.top-actions {
    display: flex;
    gap: 10px;
    align-items: center;
}

.nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 1.5px solid rgba(255,255,255,.65);
    color: white;
    padding: 8px 16px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: background .18s, border-color .18s;
}
.nav-btn:hover { background: rgba(255,255,255,.15); border-color: white; }

/* ── LAYOUT ─────────────────────────────────── */
.dashboard-layout {
    display: flex;
    padding-top: 64px;
    min-height: 100vh;
}

/* ── SIDEBAR ─────────────────────────────────── */
.sidebar {
    width: 220px;
    background: white;
    min-height: calc(100vh - 64px);
    padding: 28px 14px;
    flex-shrink: 0;
    border-right: 1px solid #e5e7eb;
}

.sidebar ul { list-style: none; }

.sidebar li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 500;
    color: #374151;
    cursor: pointer;
    transition: background .15s, color .15s;
}

.sidebar li:hover { background: #f0fdf4; color: #059669; }
.sidebar li.active { background: #d1fae5; color: #059669; font-weight: 600; }

/* ── MAIN CONTENT ────────────────────────────── */
.main-content {
    flex: 1;
    padding: 32px 28px;
    overflow-x: hidden;
}

.page-title {
    font-size: 26px;
    font-weight: 800;
    color: #111827;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 28px;
}

/* ── STAT CARDS ──────────────────────────────── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 24px;
}

.stat-card {
    background: white;
    border-radius: 18px;
    padding: 22px 24px;
    box-shadow: 0 1px 6px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.icon-box {
    width: 46px; height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}
.icon-box.blue   { background: #2563eb; }
.icon-box.green  { background: #059669; }
.icon-box.teal   { background: #0d9488; }
.icon-box.orange { background: #f59e0b; }

.stat-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 20px;
    width: fit-content;
}
.green-badge  { background: #d1fae5; color: #059669; }
.blue-badge   { background: #dbeafe; color: #2563eb; }
.orange-badge { background: #fef3c7; color: #d97706; }

.stat-card span {
    font-size: 13px;
    color: #6b7280;
    font-weight: 500;
    margin-top: 4px;
}

.stat-card h2 {
    font-size: 32px;
    font-weight: 800;
    color: #111827;
    letter-spacing: -.5px;
    line-height: 1;
}

/* ── PANELS ──────────────────────────────────── */
.panel {
    background: white;
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 1px 6px rgba(0,0,0,.07);
}

.panel h3 {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 16px;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.panel-header h3 { margin-bottom: 0; }

.lihat-detail {
    font-size: 13px;
    font-weight: 600;
    color: #059669;
    text-decoration: none;
}
.lihat-detail:hover { text-decoration: underline; }

/* ── CHART GRID ──────────────────────────────── */
.chart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.chart-wrap {
    height: 240px;
    position: relative;
}

/* ── BOTTOM GRID ─────────────────────────────── */
.bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

/* ── ACTIVITY LIST ───────────────────────────── */
.activity-list { list-style: none; }

.activity-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #f3f4f6;
}
.activity-list li:last-child { border-bottom: none; }

.dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
}
.dot.green  { background: #10b981; }
.dot.yellow { background: #f59e0b; }
.dot.red    { background: #ef4444; }

.act-info { flex: 1; }
.act-info strong { display: block; font-size: 14px; font-weight: 600; color: #111827; }
.act-info small  { font-size: 12px; color: #9ca3af; }

.act-val { font-size: 13px; font-weight: 700; white-space: nowrap; }
.act-val.plus  { color: #059669; }
.act-val.minus { color: #ef4444; }

/* ── BOOKING LIST ────────────────────────────── */
.booking-list { list-style: none; }

.booking-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #f3f4f6;
}
.booking-list li:last-child { border-bottom: none; }

.avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.booking-info { flex: 1; }
.booking-info strong { display: block; font-size: 14px; font-weight: 600; color: #111827; }
.booking-info small  { font-size: 12px; color: #9ca3af; }

.badge {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
}
.badge.lunas  { background: #d1fae5; color: #059669; }
.badge.dp     { background: #dbeafe; color: #2563eb; }
.badge.belum  { background: #fff7ed; color: #ea580c; }

/* ── RESPONSIVE ──────────────────────────────── */
@media (max-width: 1100px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
    .sidebar { display: none; }
    .chart-grid,
    .bottom-grid { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
    .stats-grid { grid-template-columns: 1fr; }
    .top-actions .nav-btn:first-child { display: none; }
}
.brand-logo-fallback{
display:none;
align-items:center;
justify-content:center;
width:100%;
height:100%;
}
.sidebar li a{
display:flex;
align-items:center;
gap:12px;
text-decoration:none;
color:inherit;
width:100%;
}
